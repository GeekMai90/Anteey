    "@vitejs/plugin-vue": "^5.1.3",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "electron-devtools-installer": "^3.2.0",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.26.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "vue": "^3.5.6",
    "vue-tsc": "^2.1.6"
  },
  "build": {
    "appId": "com.geekmai.antinet",
    "productName": "Antinet",
    "mac": {
      "category": "public.app-category.productivity",
      "extendInfo": {
        "CFBundleName": "Antinet",
        "CFBundleDisplayName": "Antinet"
      }
    }
