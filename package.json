  "build": {
    "appId": "com.geekmai.Anteey",
    "productName": "Anteey",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "extendInfo": {
        "CFBundleName": "Anteey",
        "CFBundleDisplayName": "Anteey"
      },
      "target": {
        "target": "dmg"
      }
    },
    "dmg": {
      "artifactName": "Anteey-${version}-${arch}.${ext}",
      "background": "build/background.png",
      "icon": "build/disk-icon.icns",
      "iconSize": 100,
      "contents": [
        {
          "x": 150,
          "y": 160,
          "type": "file"
        },
        {
          "x": 390,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      },
      "format": "ULFO",
      "title": "Anteey"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Anteey-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "packageManager": "pnpm@9.7.1+sha512.faf344af2d6ca65c4c5c8c2224ea77a81a5e8859cbc4e06b1511ddce2f0151512431dd19e6aff31f2c6a8f5f2aced9bd2273e1fed7dd4de1868984059d2c4247"
}
