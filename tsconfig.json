{
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "allowJs": true,
    "checkJs": false,
    "outDir": "./dist",
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "*": [
        "node_modules/*",
        "src/types/*"
      ]
    },
    "lib": [
      "es2018",
      "esnext.asynciterable",
      "dom",
      "ESNext"
    ],
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "tests/**/*.ts",
    "src/**/*.vue",
    "src/renderer/src/types/electron.d.ts",
    "src/renderer/src/utils/tiptap/CustomDragHandle.js",
    "src/renderer/src/stores/noteStorests"
  ],
  "exclude": [
    "node_modules"
  ]
}